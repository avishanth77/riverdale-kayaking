# Riverdale Kayaking Kadalundi Environment Variables
# Copy or set these in your Render.com Environment settings

PORT=3000

# Optional MongoDB Cloud Database connection string (e.g. from MongoDB Atlas Free M0 cluster)
# If provided, all bookings, dates, site content, and admin data persist permanently in MongoDB.
# If omitted, the app smoothly uses the local JSON database in data/.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/riverdale?retryWrites=true&w=majority
